{
  "name": "tuzai-x-popover",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:preview && npm run build:extension",
    "build:preview": "vite build && node scripts/prepare-sites-build.mjs",
    "build:extension": "node scripts/build-extension.mjs",
